{
  "name": "oneday",
  "version": "0.1.0",
  "description": "Obsidian plugin: highlighter-style daily timeline block, markdown as the single source of truth.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "e2e:smoke": "node e2e/render-smoke.mjs",
    "e2e:agent": "node e2e/agent-smoke.mjs",
    "e2e:api": "node e2e/api-smoke.mjs",
    "e2e:draw": "node e2e/draw-smoke.mjs",
    "e2e:grid": "node e2e/grid-smoke.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "timeline"
  ],
  "author": "yyt",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.17",
    "esbuild": "^0.25.11",
    "obsidian": "latest",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
